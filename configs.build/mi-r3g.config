# nilabsent/padavan-ng — Xiaomi MI-R3G v1 中文注释版
# 来源：trunk/configs/templates/XIAOMI/mi-r3g.config
# 说明：所有配置项的启用状态均与上游原版一致，只增加中文注释。
#
# 分类含义：
# 【机型必需】决定 R3G v1 的硬件平台、分区或无线驱动，不要改成其他机型。
# 【建议保留】普通路由使用建议保留；理论上可裁剪，但关闭前需理解影响。
# 【可选】不用对应功能即可注释掉，通常不会影响基本路由和无线。
# 【依赖/互斥】需要配合其他选项，或与其他方案二选一。
#
# 注意：配置项前加 # 才是关闭；不要删除引号、等号或修改 MI-R3G 产品 ID。

############################################################
### 一、机型平台：必需，不要改成其他型号
############################################################

# 【机型必需】厂商与 SoC 平台。R3G v1 为 XIAOMI + MT7621。
CONFIG_VENDOR=XIAOMI
CONFIG_PRODUCT=MT7621

# 【机型必需】板型与分区配置选择，必须保持 MI-R3G；不要改成 MI-R3GV2。
CONFIG_FIRMWARE_PRODUCT_ID="MI-R3G"

############################################################
### 二、Linux 内核与硬件支持
############################################################

# 【可选】强制 MT7621 以 900MHz 运行，覆盖 U-Boot 设置；一般不需要。
#CONFIG_FIRMWARE_CPU_900MHZ=y

# 【可选】空闲时降频到 220MHz；若遇到稳定性问题可保持关闭。
#CONFIG_FIRMWARE_CPU_SLEEP=y

# 【机型必需】2.4GHz 无线使用 MT7603E v4.1 驱动。
CONFIG_FIRMWARE_WIFI2_DRIVER=4.1

# 【机型必需】5GHz 无线使用 MT7612E v3.0 驱动。
CONFIG_FIRMWARE_WIFI5_DRIVER=3.0

# 【建议保留】IPv6 支持。OpenVPN 配置依赖 IPv6；不需要 IPv6 且关闭 OpenVPN 后可裁剪。
CONFIG_FIRMWARE_ENABLE_IPV6=y

# 【依赖】IPsec/XFRM 与 iptables 扩展。StrongSwan 需要；不用 IPsec/StrongSwan 可关闭。
#CONFIG_FIRMWARE_INCLUDE_XFRM=y

# 【建议保留】R3G v1 的 USB 接口支持；完全不使用 USB 时可连同 USB 存储功能一起裁剪。
CONFIG_FIRMWARE_ENABLE_USB=y

# 【可选】USB 存储与文件系统工具；不使用 USB 存储可关闭。
CONFIG_FIRMWARE_INCLUDE_FS_TOOLS=y

# 【可选】Paragon UFS 驱动提供 NTFS 支持；与 NTFS-3G 方案按需要选择。
CONFIG_FIRMWARE_ENABLE_UFSD=y

# 【可选】FAT/FAT32 文件系统。
#CONFIG_FIRMWARE_ENABLE_FAT=y

# 【可选】exFAT 文件系统，同时包含 FAT/FAT32 支持。
CONFIG_FIRMWARE_ENABLE_EXFAT=y

# 【可选】EXT2 文件系统；使用 EXT4 时通常不必单独开启。
#CONFIG_FIRMWARE_ENABLE_EXT2=y

# 【可选】EXT3 文件系统；使用 EXT4 时通常不必单独开启。
#CONFIG_FIRMWARE_ENABLE_EXT3=y

# 【可选】EXT4，并包含 EXT3/2 支持；Linux 格式 U 盘/硬盘常用。
#CONFIG_FIRMWARE_ENABLE_EXT4=y

# 【可选】XFS 文件系统，体积较大。
#CONFIG_FIRMWARE_ENABLE_XFS=y

# 【可选】Apple HFS+ 文件系统。
#CONFIG_FIRMWARE_ENABLE_HFS=y

# 【可选】FUSE 用户态文件系统框架；使用 NTFS-3G 等 FUSE 文件系统时需要。
#CONFIG_FIRMWARE_ENABLE_FUSE=y

# 【可选】swap 文件/分区支持；R3G 内存有限时可保留，但并非基本路由必需。
#CONFIG_FIRMWARE_ENABLE_SWAP=y

# 【可选】USB 摄像头 UVC 模块；不用摄像头可关闭。
#CONFIG_FIRMWARE_INCLUDE_UVC=y

# 【可选】USB HID 键盘、鼠标等输入设备支持。
#CONFIG_FIRMWARE_INCLUDE_HID=y

# 【可选】USB 串口设备，例如 PL2303。
#CONFIG_FIRMWARE_INCLUDE_SERIAL=y

# 【可选】USB 音频设备支持。
#CONFIG_FIRMWARE_INCLUDE_AUDIO=y

# 【可选】QoS 调度模块；需要 QoS 时开启，不是 CAKE 支持。
#CONFIG_FIRMWARE_INCLUDE_QOS=y

# 【依赖】IMQ 流量整形模块，需要 QoS；可能降低性能。
#CONFIG_FIRMWARE_INCLUDE_IMQ=y

# 【可选】IFB 流量整形模块，通常配合 QoS/流量控制使用。
#CONFIG_FIRMWARE_INCLUDE_IFB=y

# 【可选】TPROXY 透明代理内核支持；不使用相关代理功能可关闭。
#CONFIG_FIRMWARE_INCLUDE_TPROXY=y

# 【可选/建议按功能保留】IPSet 工具和内核模块；策略路由、Zapret 等功能可能使用。
#CONFIG_FIRMWARE_INCLUDE_IPSET=y

# 【可选】NFSv3 服务端；不让其他设备通过 NFS 访问路由器存储可关闭。
#CONFIG_FIRMWARE_INCLUDE_NFSD=y

# 【可选】NFSv3 客户端；不让路由器挂载远程 NFS 可关闭。
#CONFIG_FIRMWARE_INCLUDE_NFSC=y

# 【可选】CIFS/SMB 客户端，用于挂载远程 Windows/Samba 共享。
#CONFIG_FIRMWARE_INCLUDE_CIFS=y

# 【建议保留】Shortcut Forward Engine 加速转发；注重 NAT 性能时保留。
# 若排查特定 QoS/代理兼容问题，可将其作为对照测试项。
CONFIG_FIRMWARE_INCLUDE_SHORTCUT_FE=y

# 【可选】编译回移植的媒体设备驱动，普通路由使用不需要。
#CONFIG_FIRMWARE_ENABLE_BACKPORTED=y

# 【依赖】把上述回移植媒体驱动放入固件；不开启上一项时无实际用途。
# 不放入固件时，驱动可另外打包到 /opt/lib/。
#CONFIG_FIRMWARE_INCLUDE_BACKPORTED=y

############################################################
### 三、Web 界面、基础工具与存储服务
############################################################

# 【可选】WebUI 语言资源。英文界面为基础资源；这里额外包含俄语，不需要可关闭。
# 简体中文 LANG_CN 由 pre-build.sh 注入 Makefile 后生效，见文件末尾。
#CONFIG_FIRMWARE_INCLUDE_LANG_BR=y
#CONFIG_FIRMWARE_INCLUDE_LANG_CZ=y
#CONFIG_FIRMWARE_INCLUDE_LANG_DA=y
#CONFIG_FIRMWARE_INCLUDE_LANG_DE=y
#CONFIG_FIRMWARE_INCLUDE_LANG_ES=y
#CONFIG_FIRMWARE_INCLUDE_LANG_FI=y
#CONFIG_FIRMWARE_INCLUDE_LANG_FR=y
#CONFIG_FIRMWARE_INCLUDE_LANG_NO=y
#CONFIG_FIRMWARE_INCLUDE_LANG_PL=y
#CONFIG_FIRMWARE_INCLUDE_LANG_RU=y
#CONFIG_FIRMWARE_INCLUDE_LANG_SV=y
#CONFIG_FIRMWARE_INCLUDE_LANG_UK=y

# 【可选】WebUI 显示路由器厂商图标，不影响功能。
# 关闭后使用 Padavan 默认 logo，而非小米厂商图标。
#CONFIG_FIRMWARE_INCLUDE_VENDOR_LOGO=y

# 【可选】以减小 trx 体积为优化目标；若固件超限可尝试，通常不是首选删减方式。
#CONFIG_CC_OPTIMIZE_FOR_SIZE=y

# 【可选】dnsmasq 正则表达式功能；普通 DHCP/DNS 使用不需要。
#CONFIG_FIRMWARE_ENABLE_DNSMASQ_REGEX=y

# 【依赖/互斥】NTFS-3G 用户态 NTFS 驱动，需要 FUSE；用于替代 Paragon UFS。
# 一般与 CONFIG_FIRMWARE_ENABLE_UFSD 按需要选择，不必为了同一用途同时保留。
#CONFIG_FIRMWARE_INCLUDE_NTFS_3G=y

# 【可选】USB 打印机 LPR 服务；不用打印机可关闭。
#CONFIG_FIRMWARE_INCLUDE_LPRD=y

# 【可选】USB-over-Ethernet 打印机服务；不用打印机可关闭。
#CONFIG_FIRMWARE_INCLUDE_U2EC=y

# 【可选】tcpdump 抓包工具；不诊断网络可关闭，能节省较多空间。
#CONFIG_FIRMWARE_INCLUDE_TCPDUMP=y

# 【可选】hdparm，用于硬盘休眠、超时与 APM 设置。
#CONFIG_FIRMWARE_INCLUDE_HDPARM=y

# 【可选】parted，用于创建 GPT 分区；不在路由器上分区可关闭。
#CONFIG_FIRMWARE_INCLUDE_PARTED=y

# 【互斥/按需选择】旧 SMB/WINS 文件共享服务；与 SMBD36 按需要选择。
#CONFIG_FIRMWARE_INCLUDE_SMBD=y

# 【可选】SMB2 文件共享服务；不使用路由器作 SMB 服务器可关闭。
#CONFIG_FIRMWARE_INCLUDE_SMBD36=y

# 【可选】仅 WINS 名称服务，现代网络通常不需要。
#CONFIG_FIRMWARE_INCLUDE_WINS=y

# 【依赖】SMB/WINS 的 syslog 支持，仅在启用相应服务时有意义。
#CONFIG_FIRMWARE_INCLUDE_SMBD_SYSLOG=y

# 【可选】FTP 服务端；不需要 FTP 文件共享时建议关闭以减少服务和体积。
#CONFIG_FIRMWARE_INCLUDE_FTPD=y

# 【可选】RP-L2TP 客户端，仅特定 L2TP 接入方式需要。
#CONFIG_FIRMWARE_INCLUDE_RPL2TP=y

# 【可选】EAP-TTLS/EAP-PEAP 认证支持，企业认证场景才需要；会引入 OpenSSL。
#CONFIG_FIRMWARE_INCLUDE_EAP_PEAP=y

# 【可选】DDNS 客户端 HTTPS 支持；使用需要 HTTPS 的 DDNS 服务时保留。
#CONFIG_FIRMWARE_INCLUDE_DDNS_SSL=y

# 【建议保留】HTTPS 支持，涉及 Web/远程加密访问等；会引入 OpenSSL。
#CONFIG_FIRMWARE_INCLUDE_HTTPS=y

# 【可选】SFTP 服务端，需要 OpenSSL 1.1 或更高版本；不用 SFTP 可关闭。
#CONFIG_FIRMWARE_INCLUDE_SFTP=y

# 【可选】Dropbear SSH 服务端；不使用 SSH 可关闭，使用 SSH 时建议仅保留一种 SSH 实现。
CONFIG_FIRMWARE_INCLUDE_DROPBEAR=y

# 【依赖】Dropbear 的对称加密与哈希加速代码，仅在使用 Dropbear 时有意义。
CONFIG_FIRMWARE_INCLUDE_DROPBEAR_FAST_CODE=y

# 【互斥/可选】使用 OpenSSH 替代 Dropbear；不要仅为同一 SSH 用途同时启用两套服务。
# 需要 OpenSSL 1.1 或更高版本。
#CONFIG_FIRMWARE_INCLUDE_OPENSSH=y

############################################################
### 四、VPN 与加密组件：全部属于按需功能
############################################################

# 【依赖/可选】OpenVPN，需要 IPv6 和 OpenSSL；不用 OpenVPN 可关闭。
#CONFIG_FIRMWARE_INCLUDE_OPENVPN=y

# 【依赖/可选】StrongSwan IPsec VPN，需要 XFRM；不用 IPsec VPN 可连同 XFRM 裁剪。
#CONFIG_FIRMWARE_INCLUDE_SSWAN=y

# 【可选】AmneziaWG 内核模块和工具；仅使用 AmneziaWG 时保留。
#CONFIG_FIRMWARE_INCLUDE_AMNEZIAWG=y

# 【互斥/按需选择】WireGuard 内核模块和工具；不与 AmneziaWG 为普通 WireGuard 用途同时开启。
#CONFIG_FIRMWARE_INCLUDE_WIREGUARD=y

# 【建议按加密服务保留】OpenSSL 椭圆曲线支持；现代 TLS/SSH/VPN 通常建议保留。
CONFIG_FIRMWARE_INCLUDE_OPENSSL_EC=y

# 【可选】openssl 命令行程序，用于手动生成证书等；只使用 WebUI 时通常可裁剪。
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_EXE=y

############################################################
### 五、媒体与下载服务：占用空间较大，优先按需删减
############################################################

# 【可选】xUPnPd IPTV 媒体服务；不看 IPTV 可关闭。
#CONFIG_FIRMWARE_INCLUDE_XUPNPD=y

# 【可选】MiniDLNA 媒体服务器；不提供 DLNA 媒体共享可关闭，体积较大。
#CONFIG_FIRMWARE_INCLUDE_MINIDLNA=y

# 【可选】Firefly iTunes 媒体服务器。
#CONFIG_FIRMWARE_INCLUDE_FIREFLY=y

# 【可选】Transmission BT 下载，需要 OpenSSL；不用 BT 下载可关闭。
#CONFIG_FIRMWARE_INCLUDE_TRANSMISSION=y

# 【依赖】Transmission Web Control；关闭 Transmission 时应一并关闭。
#CONFIG_FIRMWARE_INCLUDE_TRANSMISSION_WEB_CONTROL=y

# 【可选】Aria2 下载工具，需要 OpenSSL，体积很大；不用 Aria2 可关闭。
#CONFIG_FIRMWARE_INCLUDE_ARIA=y

# 【依赖】Aria2 Web 控制界面；关闭 Aria2 时应一并关闭。
#CONFIG_FIRMWARE_INCLUDE_ARIA_WEB_CONTROL=y

# 【可选】Tor 代理，体积较大。
#CONFIG_FIRMWARE_INCLUDE_TOR=y

# 【依赖】Tor GeoIP 数据库，仅在启用 Tor 且有查询需求时开启。
#CONFIG_FIRMWARE_INCLUDE_TOR_GEOIP=y

# 【依赖】Tor IPv6 GeoIP 数据库，仅在启用 Tor 且有查询需求时开启。
#CONFIG_FIRMWARE_INCLUDE_TOR_GEOIPV6=y

# 【可选】Privoxy HTTP 代理。
#CONFIG_FIRMWARE_INCLUDE_PRIVOXY=y

############################################################
### 六、DNS 与网络工具
############################################################

# 【可选】DNSCrypt 加密 DNS；不使用可关闭。
#CONFIG_FIRMWARE_INCLUDE_DNSCRYPT=y

# 【可选】Stubby，提供 DNS-over-TLS；不使用 DoT 可关闭，需要 OpenSSL。
#CONFIG_FIRMWARE_INCLUDE_STUBBY=y

# 【可选】https_dns_proxy，提供 DNS-over-HTTPS；不使用 DoH 可关闭，需要 OpenSSL。
#CONFIG_FIRMWARE_INCLUDE_DOH=y

# 【可选】curl 命令行工具；需要 OpenSSL，不使用时可关闭。
#CONFIG_FIRMWARE_INCLUDE_CURL=y

# 【依赖/可选】curl QUIC 支持，并会引入 OpenSSL 3.5；体积较大，不需要 QUIC 时建议关闭。
#CONFIG_FIRMWARE_INCLUDE_QUIC=y

# 【依赖/高级选项】替换默认 OpenSSL 3.0 的版本选择；普通用户保持原状。
# OpenSSL 1.0：
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_10=y
# OpenSSL 1.1：
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_11=y
# OpenSSL 3.5：
#CONFIG_FIRMWARE_INCLUDE_OPENSSL_35=y

# 【可选】WPAD 代理自动发现；不使用自动代理可关闭。
#CONFIG_FIRMWARE_INCLUDE_WPAD=y

# 【建议保留】ZRAM 压缩内存，适合 R3G v1 的有限内存；并非强制必需。
CONFIG_FIRMWARE_INCLUDE_ZRAM=y

# 【可选】ADB 安卓调试桥工具，普通路由使用不需要，可关闭。
#CONFIG_FIRMWARE_INCLUDE_ADB=y

# 【可选】Lua 脚本运行支持；没有相关脚本需求可关闭。
#CONFIG_FIRMWARE_INCLUDE_LUA=y

# 【可选】EoIP 以太网 over IP 隧道。
#CONFIG_FIRMWARE_INCLUDE_EOIP=y

# 【可选】Zapret；不使用其网络处理功能可关闭。
#CONFIG_FIRMWARE_INCLUDE_ZAPRET=y

# 【可选】Zapret2；与 Zapret 按实际需求选择，不必默认全部保留。
#CONFIG_FIRMWARE_INCLUDE_ZAPRET2=y

# 【可选】qrencode 二维码生成工具。
#CONFIG_FIRMWARE_INCLUDE_QRENCODE=y

# 【可选】iPerf3 网络测速工具。
#CONFIG_FIRMWARE_INCLUDE_IPERF3=y

# 【可选】redsocks2 透明代理工具。
#CONFIG_FIRMWARE_INCLUDE_REDSOCKS2=y

# 【可选】ZeroTier 虚拟组网。
#CONFIG_FIRMWARE_INCLUDE_ZEROTIER=y

# 【可选】Shadowsocks 透明代理。
#CONFIG_FIRMWARE_INCLUDE_SSREDIR=y

# 【可选】Shadowsocks 本地 SOCKS5 代理。
#CONFIG_FIRMWARE_INCLUDE_SSLOCAL=y

############################################################
### 七、固件超限时建议优先关闭的项目
############################################################
# 以下只是注释说明，不是新的配置项；请回到上方对应行添加 #。
# 第一梯队（通常最不影响基本路由）：
#   ARIA + ARIA_WEB_CONTROL、TRANSMISSION + TRANSMISSION_WEB_CONTROL
#   MINIDLNA、XUPNPD、ADB、TCPDUMP、UVC、LPRD、U2EC、LANG_RU、QUIC
# 第二梯队（确认完全不用对应服务后）：
#   SSWAN + XFRM、OPENVPN、AMNEZIAWG、DNSCRYPT、STUBBY、DOH
#   SMBD36、FTPD、SFTP、NFSD、NFSC、CIFS、EAP_PEAP
# 不建议为了缩小体积而修改：
#   CONFIG_VENDOR、CONFIG_PRODUCT、CONFIG_FIRMWARE_PRODUCT_ID
#   CONFIG_FIRMWARE_WIFI2_DRIVER、CONFIG_FIRMWARE_WIFI5_DRIVER
